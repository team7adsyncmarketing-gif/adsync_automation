# =====================================================================
# AdSync Control Center — Production & Local Environment Configuration
# =====================================================================

# Server & Runtime Configuration
PORT=8000
ENVIRONMENT=production
FORCE_MOCK_MODE=1

# Supabase Production Database & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=adsync-reels
# Optional direct Postgres connection string for Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Meta Instagram Graph API Configuration
INSTAGRAM_ACCESS_TOKEN=your-long-lived-page-access-token
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_DRY_RUN=1

# SocialFetch Trend Intelligence API
SOCIAL_FETCH_API_KEY=your-social-fetch-api-key
SOCIAL_FETCH_BASE_URL=https://api.socialfetch.dev
TREND_DATABASE_PATH=trend_engine/data/trends.db

# Cloud Video Rendering Worker
# Options: 'local' (render on host machine) or 'cloud' (dispatch to worker)
WORKER_MODE=local
RENDER_WORKER_URL=https://adsync-render-worker.onrender.com
RENDER_WORKER_API_KEY=your-worker-shared-secret
