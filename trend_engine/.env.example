# ==============================================================================
# AdSync Trend Engine - Environment Configuration Template
# COPY this file to .env and insert your real credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Social Fetch API Configuration
# Get your API key from https://www.socialfetch.dev/
SOCIAL_FETCH_API_KEY=your_social_fetch_api_key_here
SOCIAL_FETCH_BASE_URL=https://api.socialfetch.dev

# Database Configuration (Relative to project root or absolute)
TREND_DATABASE_PATH=trend_engine/data/trends.db

# Execution Mode: Set to 1 to force mock mode even if an API key is present
FORCE_MOCK_MODE=1

